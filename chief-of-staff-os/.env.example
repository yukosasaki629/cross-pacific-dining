# =============================================================================
# Chief of Staff OS — 環境設定
# =============================================================================
# このファイルを `.env` という名前にコピーして使ってください。
# デフォルトは「ローカルモード」です。下の設定を変更しない限り、
# このパソコンの外には何も出ません。
# =============================================================================

# --- データベース(ローカルSQLite — 通常は変更不要) ---
DATABASE_URL="file:./dev.db"

# --- AIプロバイダ選択 ---
# 利用可能な値:
#   "mock"      → ルールベースのローカル抽出。ネットワーク通信なし。(デフォルト)
#   "anthropic" → 会議メモ・文字起こしを Anthropic の Claude API に送信。
#                 社内ポリシーで第三者AIへの送信が許可されている場合のみ有効化。
#                 ANTHROPIC_API_KEY の設定が必要。
AI_PROVIDER="mock"

# --- Anthropic (任意、AI_PROVIDER="anthropic" 時のみ使用) ---
# キーは https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"

# --- 新規レコードの既定機密度 ---
# 値: "Internal" | "Confidential" | "Restricted"
DEFAULT_CONFIDENTIALITY="Confidential"
