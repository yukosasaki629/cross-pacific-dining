# =============================================================================
# Chief of Staff OS — environment configuration
# =============================================================================
# Copy this file to `.env` and edit values as needed.
# Defaults are LOCAL-ONLY. Nothing leaves your computer unless you opt in below.
# =============================================================================

# --- Database (local SQLite file; do not change unless you know what you're doing) ---
DATABASE_URL="file:./dev.db"

# --- AI provider selection ---
# Allowed values:
#   "mock"      → rule-based local extraction. No network calls. (DEFAULT)
#   "anthropic" → sends meeting notes/transcripts to Anthropic's Claude API.
#                 ONLY enable if your company policy permits sending executive
#                 content to a third-party AI vendor. Requires ANTHROPIC_API_KEY.
AI_PROVIDER="mock"

# --- Anthropic (optional, only used when AI_PROVIDER="anthropic") ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"

# --- Confidentiality default for new records ---
# Allowed: "Internal" | "Confidential" | "Restricted"
DEFAULT_CONFIDENTIALITY="Confidential"
