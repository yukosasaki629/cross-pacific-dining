// CEOダッシュボード — フラットなスキーマ。
// 各モデルは将来 Smartsheet / Microsoft Lists / Google Sheets の1シートに
// マッピング可能なように、外部キー連携は最小限・他はテキストフィールドで保持。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(cuid())
  name            String
  objective       String?
  owner           String?    // スプレッドシート互換のためテキスト
  department      String?
  status          String   @default("順調")    // 順調 | 注意 | 遅延 | 停止中 | 完了
  riskLevel       String   @default("低")      // 低 | 中 | 高
  priority        String   @default("中")      // 低 | 中 | 高
  nextAction      String?
  dueDate         DateTime?
  currentSummary  String?
  successMetric   String?
  isSharedWithCEO Boolean  @default(true)      // false にすると共有ビューから除外
  privateMemo     String?                      // 優子専用、共有ビューには出さない
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks     Task[]
  decisions Decision[]
  risks     Risk[]
  updates   Update[]
}

model Task {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  owner     String?
  status    String   @default("未着手") // 未着手 | 進行中 | 待機中 | 完了 | ブロック
  dueDate   DateTime?
  priority  String   @default("中")     // 低 | 中 | 高
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decision {
  id              String   @id @default(cuid())
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  topic           String
  background      String?
  options         String?
  recommendation  String?
  deadline        DateTime?
  impactIfDelayed String?
  importance      String   @default("中") // 低 | 中 | 高
  status          String   @default("未対応") // 未対応 | 検討中 | 判断済 | 中止
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Risk {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description String
  severity    String   @default("中")    // 低 | 中 | 高
  mitigation  String?
  owner       String?
  status      String   @default("対応中") // 未対応 | 対応中 | 解消
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Update {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  content    String
  nextAction String?
  createdAt  DateTime @default(now())
}

// 優子が個人的にフォローすべき項目。プロジェクトに紐づけてもよいし、独立でもよい。
model FollowUp {
  id        String   @id @default(cuid())
  projectId String?
  title     String
  who       String?    // フォロー対象者(例:CFO、IT部長)
  dueDate   DateTime?
  status    String   @default("未対応") // 未対応 | 進行中 | 完了
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
