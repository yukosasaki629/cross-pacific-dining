// CEOダッシュボード — フラットなスキーマ。
// 各モデルは将来 Smartsheet / Microsoft Lists / Google Sheets の1シートに
// マッピング可能なように、外部キー連携は最小限・他はテキストフィールドで保持。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- 1on1 相手 ---
model Person {
  id        String   @id @default(cuid())
  name      String
  role      String?   // CEO / CFO / COO / CMO / IT部長 など
  email     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings  MeetingNote[]
  topics    Topic[]
}

// --- 1on1 ノート ---
model MeetingNote {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  rawNotes        String                                // 貼り付けた生メモ(常に保存)
  summary         String?                               // 抽出されたサマリー
  processedAt     DateTime?                             // 抽出を「適用」した日時
  // --- 共有制御 ---
  // メモ本文は常に internal。派生する Task/Decision/Risk は ceo_shared をデフォルトに、
  // 機密キーワードを含む場合は自動的に sensitivity を立てる。
  rawVisibility   String   @default("internal")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 派生レコード(処理時に自動作成される)
  tasks      Task[]
  decisions  Decision[]
  risks      Risk[]
  followUps  FollowUp[]
  updates    Update[]
  topics     Topic[]
}

// =============================================================================
// Topic — 1on1で出た「話題」の単位。
// 自動分類ではなく、ユーザーが⭐重要 / 📌フォロー要 を自分でトグルで割り振る。
// =============================================================================
model Topic {
  id            String       @id @default(cuid())
  meetingNoteId String?
  meetingNote   MeetingNote? @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  personId      String?
  person        Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title         String                                // 短いトピック名
  content       String?                              // 詳細・背景

  // ⭐ 主要フラグ(ユーザーが手動で立てる)
  isImportant   Boolean      @default(false)         // ⭐ 重要
  needsFollowUp Boolean      @default(false)         // 📌 フォロー要

  // 任意のカテゴリ
  category      String       @default("info")        // action | decision | risk | info | other

  // ステータス
  status        String       @default("open")        // open | in_progress | done | cancelled

  // 関連
  owner         String?
  dueDate       DateTime?

  // 共有制御
  visibility    String       @default("internal")    // internal | ceo_shared
  sensitivity   String       @default("general")     // general | board | compensation | executive_only

  // P&L 影響(学習・分析用)
  pnlImpact         String?  // sales | food_cost | labor_cost | ga | null
  strategicCategory String?  // aop | strategy | board | null

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  name            String
  objective       String?
  owner           String?    // スプレッドシート互換のためテキスト
  department      String?
  status          String   @default("順調")    // 順調 | 注意 | 遅延 | 停止中 | 完了
  riskLevel       String   @default("低")      // 低 | 中 | 高
  priority        String   @default("中")      // 低 | 中 | 高
  nextAction      String?
  dueDate         DateTime?
  currentSummary  String?
  successMetric   String?
  isSharedWithCEO Boolean  @default(true)      // false にすると共有ビューから除外
  privateMemo     String?                      // 優子専用、共有ビューには出さない
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks     Task[]
  decisions Decision[]
  risks     Risk[]
  updates   Update[]
  topics    Topic[]
}

model Task {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingNoteId String?
  meetingNote   MeetingNote? @relation(fields: [meetingNoteId], references: [id], onDelete: SetNull)
  title         String
  owner         String?
  status        String   @default("未着手") // 未着手 | 進行中 | 待機中 | 完了 | ブロック
  dueDate       DateTime?
  priority      String   @default("中")     // 低 | 中 | 高
  memo          String?
  visibility    String   @default("internal") // 派生時は ceo_shared がデフォルト
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Decision {
  id              String   @id @default(cuid())
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingNoteId   String?
  meetingNote     MeetingNote? @relation(fields: [meetingNoteId], references: [id], onDelete: SetNull)
  topic           String
  background      String?
  options         String?
  recommendation  String?
  deadline        DateTime?
  impactIfDelayed String?
  importance      String   @default("中") // 低 | 中 | 高
  status          String   @default("未対応") // 未対応 | 検討中 | 判断済 | 中止
  decisionType    String   @default("needed") // needed(判断待ち) | made(決定済)
  // --- 共有ビュー制御 ---
  visibility      String   @default("internal")  // internal(優子のみ) | ceo_shared(社長と共有)
  sensitivity     String   @default("general")   // general | board | compensation | executive_only
                                                  // general 以外は共有ビュー・共有レポートから自動除外
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Risk {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingNoteId String?
  meetingNote   MeetingNote? @relation(fields: [meetingNoteId], references: [id], onDelete: SetNull)
  description   String
  severity      String   @default("中")    // 低 | 中 | 高
  mitigation    String?
  owner         String?
  status        String   @default("対応中") // 未対応 | 対応中 | 解消
  visibility    String   @default("internal")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Update {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meetingNoteId String?
  meetingNote   MeetingNote? @relation(fields: [meetingNoteId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  content       String
  nextAction    String?
  visibility    String   @default("internal")
  createdAt     DateTime @default(now())
}

// 優子が個人的にフォローすべき項目。プロジェクトに紐づけてもよいし、独立でもよい。
model FollowUp {
  id            String   @id @default(cuid())
  projectId     String?
  meetingNoteId String?
  meetingNote   MeetingNote? @relation(fields: [meetingNoteId], references: [id], onDelete: SetNull)
  title         String
  who           String?    // フォロー対象者(例:CFO、IT部長)
  dueDate       DateTime?
  status        String   @default("未対応") // 未対応 | 進行中 | 完了
  memo          String?
  visibility    String   @default("internal")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
